{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OpenFlyover",
  "version": "3.1.0",
  "identifier": "io.github.yannickriou.openflyover",
  "build": {
    "beforeDevCommand": "npm run dev -- --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenFlyover",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https://tiles.mapterhorn.com https://s3.amazonaws.com https://data.geopf.fr https://wmts.geo.admin.ch https://services.arcgisonline.com https://wayback.maptiles.arcgis.com https://mapsneu.wien.gv.at https://cyberjapandata.gsi.go.jp https://basemap.nationalmap.gov https://*.tile.opentopomap.org",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: https://tiles.mapterhorn.com https://s3.amazonaws.com https://data.geopf.fr https://wmts.geo.admin.ch https://services.arcgisonline.com https://wayback.maptiles.arcgis.com https://mapsneu.wien.gv.at https://cyberjapandata.gsi.go.jp https://basemap.nationalmap.gov https://*.tile.opentopomap.org https://metadata.maptiles.arcgis.com https://s3-us-west-2.amazonaws.com https://archive-api.open-meteo.com https://api.open-meteo.com https://overpass-api.de https://maps.mail.ru https://www.strava.com"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "license": "MIT",
    "licenseFile": "installer/license.rtf",
    "shortDescription": "Films de survol 3D à partir de traces GPX et FIT",
    "resources": { "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["opnflvr"],
        "name": "Projet OpenFlyover",
        "description": "Projet OpenFlyover",
        "mimeType": "application/x-opnflvr",
        "role": "Editor",
        "rank": "Owner",
        "exportedType": { "identifier": "io.github.yannickriou.openflyover.project", "conformsTo": ["public.data"] }
      }
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/open-flyover/copyright": "installer/license.txt",
          "/usr/share/mime/packages/openflyover-opnflvr.xml": "mime/openflyover-opnflvr.xml"
        }
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "both",
        "languages": ["French"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "uninstallerHeaderImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "language": "fr-FR",
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 270 },
        "applicationFolderPosition": { "x": 480, "y": 270 }
      }
    }
  }
}
